# Database Configuration
# Format: file:./path/to/dev.db
DATABASE_URL=file:./dev.db

# Server Configuration
# Backend server port
PORT=8787

# Node environment (development or production)
NODE_ENV=development

# Frontend Configuration
# URL of the frontend for CORS configuration
FRONTEND_ORIGIN=http://localhost:3000

# JWT Configuration
# Secret key for signing JWT tokens (change this in production!)
# Generate a strong random string for production
JWT_SECRET=your-super-secret-jwt-key-change-in-production-12345

# API URL (for frontend to communicate with backend)
NEXT_PUBLIC_API_URL=http://localhost:8787/api
